# Copy to .env and adjust. docker-compose.yml sets these for containers;
# this file is for running backend tools (alembic, scripts) directly on the host.
DATABASE_URL=postgresql+psycopg://brandnest:brandnest@localhost:5432/brandnest

# The deals desk at /admin. ADMIN_USER signs every verification, so use a real
# name. Both must be set to something private before the API is reachable from
# outside this machine (RUNBOOK §2).
ADMIN_USER=founder
ADMIN_PASSWORD=change-me
